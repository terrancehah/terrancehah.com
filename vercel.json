{
    "framework": null,
    "cleanUrls": true,
    "functions": {
        "api/*.py": {
            "maxDuration": 60,
            "excludeFiles": "{resources,public,playground,articles,projects,dist,src,styles,.archive,node_modules,.venv,venv,.vercel}/**"
        }
    },
    "rewrites": [
        {
            "source": "/projects/running-posture-analyser/analyse",
            "destination": "/api/analyse"
        },
        {
            "source": "/projects/runassist/api/(.*)",
            "destination": "/api/$1"
        }
    ]
}
