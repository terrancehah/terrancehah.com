{
    "framework": null,
    "cleanUrls": true,
    "functions": {
        "api/*.py": {
            "maxDuration": 60,
            "excludeFiles": "{resources,public,playground,articles,projects,dist,src,styles,.archive,node_modules,.venv,venv,.vercel}/**"
        }
    },
    "redirects": [
        {
            "source": "/projects/pacey",
            "destination": "/pacey",
            "permanent": true
        },
        {
            "source": "/projects/pacey/",
            "destination": "/pacey",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/pacey",
            "destination": "/projects/pacey/index.html"
        },
        {
            "source": "/pacey/",
            "destination": "/projects/pacey/index.html"
        },
        {
            "source": "/projects/running-posture-analyser/analyse",
            "destination": "/api/analyse"
        },
        {
            "source": "/projects/pacey/api/(.*)",
            "destination": "/api/$1"
        }
    ]
}
