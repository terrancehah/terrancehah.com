{
    "cleanUrls": true,
    "functions": {
        "api/index.py": {
            "excludeFiles": "{resources/**,playground/**,articles/**,projects/**,dist/**,src/**,*.html,*.mp4,*.mov,*.jpg,*.jpeg,*.png,*.gif,*.webp,*.JPG,*.glb,*.json,*.md,*.txt,*.css,*.js,*.mjs,*.svg,*.ico,*.woff,*.woff2,*.ttf,*.eot,*.otf}"
        }
    },
    "rewrites": [
        {
            "source": "/projects/running-posture-analyser/analyse",
            "destination": "/api/analyse"
        },
        {
            "source": "/projects/race-goal-dashboard/api/(.*)",
            "destination": "/api/$1"
        }
    ]
}
