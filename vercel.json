{
    "cleanUrls": true,
    "functions": {
        "api/*.py": {
            "maxDuration": 60,
            "excludeFiles": "{resources/**,public/**,playground/**,articles/**,projects/**,dist/**,src/**,*.html,*.mp4,*.mov,*.jpg,*.jpeg,*.png,*.gif,*.webp,*.JPG,*.glb,*.json,*.md,*.txt,*.css,*.js,*.mjs,*.svg,*.ico,*.woff,*.woff2,*.ttf,*.eot,*.otf}"
        }
    },
    "redirects": [
        { "source": "/projects/runassist.html", "destination": "/projects/runassist", "permanent": true },
        { "source": "/projects/running-posture-analyser.html", "destination": "/projects/running-posture-analyser", "permanent": true },
        { "source": "/projects/foodtracker.html", "destination": "/projects/foodtracker", "permanent": true },
        { "source": "/projects/anniversary.html", "destination": "/projects/anniversary", "permanent": true },
        { "source": "/projects/career-plan.html", "destination": "/projects/career-plan", "permanent": true },
        { "source": "/projects/form-a-story.html", "destination": "/projects/form-a-story", "permanent": true },
        { "source": "/projects/teaching-syllabus-template.html", "destination": "/projects/teaching-syllabus-template", "permanent": true }
    ],
    "rewrites": [
        {
            "source": "/projects/running-posture-analyser/analyse",
            "destination": "/api/analyse"
        },
        {
            "source": "/projects/runassist/api/(.*)",
            "destination": "/api/$1"
        }
    ]
}
